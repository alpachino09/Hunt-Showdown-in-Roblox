{
  "name": "GreyOutpost-Rush",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "../src/shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "SharedServer": {
        "$path": "../src/server"
      },
      "RushServer": {
        "$path": "../places/rush/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "RushMap": {
        "$path": "../build/generated/RushMap.rbxmx"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "ExpeditionClient": {
          "$path": "../src/expedition-client"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui"
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": true
      }
    },
    "SoundService": {
      "$className": "SoundService"
    },
    "Lighting": {
      "$className": "Lighting"
    }
  }
}
